{
  "name": "NP Message",
  "module": "NP Core",
  "doctype": "DocType",
  "engine": "InnoDB",
  "is_submittable": 0,
  "issingle": 0,
  "istable": 0,
  "editable_grid": 1,
  "track_changes": 1,
  "sort_field": "creation",
  "sort_order": "DESC",
  "naming_rule": "Expression",
  "autoname": "NP-MSG-.#####",
  "fields": [
    {
      "fieldname": "subject",
      "fieldtype": "Data",
      "label": "Subject"
    },
    {
      "fieldname": "content",
      "fieldtype": "Text Editor",
      "label": "Content"
    },
    {
      "fieldname": "channel",
      "fieldtype": "Link",
      "options": "NP Channel",
      "label": "Channel",
      "in_list_view": 1
    },
    {
      "fieldname": "recipient",
      "fieldtype": "Data",
      "label": "Recipient",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "recipient_type",
      "fieldtype": "Select",
      "options": "Email\nPhone\nUser\nDevice Token\nChat ID",
      "label": "Recipient Type"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "options": "Pending\nQueued\nSent\nDelivered\nFailed\nBounced\nOptedOut",
      "label": "Status",
      "default": "Pending",
      "in_list_view": 1
    },
    {
      "fieldname": "cb1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "priority",
      "fieldtype": "Select",
      "options": "Low\nMedium\nHigh\nCritical",
      "label": "Priority",
      "default": "Medium"
    },
    {
      "fieldname": "template",
      "fieldtype": "Link",
      "options": "NP Template",
      "label": "Template"
    },
    {
      "fieldname": "campaign",
      "fieldtype": "Link",
      "options": "NP Campaign",
      "label": "Campaign"
    },
    {
      "fieldname": "reference_doctype",
      "fieldtype": "Link",
      "options": "DocType",
      "label": "Reference DocType"
    },
    {
      "fieldname": "reference_name",
      "fieldtype": "Dynamic Link",
      "options": "reference_doctype",
      "label": "Reference Name"
    },
    {
      "fieldname": "sb_delivery",
      "fieldtype": "Section Break",
      "label": "Delivery Info"
    },
    {
      "fieldname": "sent_at",
      "fieldtype": "Datetime",
      "label": "Sent At",
      "read_only": 1
    },
    {
      "fieldname": "delivered_at",
      "fieldtype": "Datetime",
      "label": "Delivered At",
      "read_only": 1
    },
    {
      "fieldname": "read_at",
      "fieldtype": "Datetime",
      "label": "Read At",
      "read_only": 1
    },
    {
      "fieldname": "external_id",
      "fieldtype": "Data",
      "label": "External Message ID",
      "read_only": 1
    },
    {
      "fieldname": "error_message",
      "fieldtype": "Small Text",
      "label": "Error Message",
      "read_only": 1
    },
    {
      "fieldname": "retry_count",
      "fieldtype": "Int",
      "label": "Retry Count",
      "read_only": 1,
      "default": "0"
    },
    {
      "fieldname": "cost",
      "fieldtype": "Currency",
      "label": "Cost",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "NP Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}