{
  "name": "NP Queue",
  "module": "NP Core",
  "doctype": "DocType",
  "engine": "InnoDB",
  "is_submittable": 0,
  "issingle": 0,
  "istable": 0,
  "editable_grid": 1,
  "track_changes": 1,
  "sort_field": "creation",
  "sort_order": "DESC",
  "naming_rule": "Expression",
  "autoname": "NP-Q-.#####",
  "fields": [
    {
      "fieldname": "message",
      "fieldtype": "Link",
      "options": "NP Message",
      "label": "Message",
      "reqd": 1
    },
    {
      "fieldname": "channel",
      "fieldtype": "Link",
      "options": "NP Channel",
      "label": "Channel",
      "reqd": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "options": "Pending\nProcessing\nCompleted\nFailed",
      "label": "Status",
      "default": "Pending",
      "in_list_view": 1
    },
    {
      "fieldname": "scheduled_at",
      "fieldtype": "Datetime",
      "label": "Scheduled At"
    },
    {
      "fieldname": "processed_at",
      "fieldtype": "Datetime",
      "label": "Processed At",
      "read_only": 1
    },
    {
      "fieldname": "retry_count",
      "fieldtype": "Int",
      "label": "Retry Count",
      "default": "0"
    },
    {
      "fieldname": "next_retry_at",
      "fieldtype": "Datetime",
      "label": "Next Retry At"
    },
    {
      "fieldname": "error_log",
      "fieldtype": "Small Text",
      "label": "Error Log",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "NP Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}