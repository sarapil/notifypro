{
  "name": "NP In-App Notification",
  "module": "NP Core",
  "doctype": "DocType",
  "engine": "InnoDB",
  "is_submittable": 0,
  "issingle": 0,
  "istable": 0,
  "editable_grid": 1,
  "track_changes": 1,
  "sort_field": "creation",
  "sort_order": "DESC",
  "naming_rule": "Expression",
  "autoname": "NP-INAPP-.#####",
  "fields": [
    {
      "fieldname": "user",
      "fieldtype": "Link",
      "options": "User",
      "label": "User",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Title",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "body",
      "fieldtype": "Small Text",
      "label": "Body"
    },
    {
      "fieldname": "read",
      "fieldtype": "Check",
      "label": "Read",
      "default": "0",
      "in_list_view": 1
    },
    {
      "fieldname": "reference_doctype",
      "fieldtype": "Link",
      "options": "DocType",
      "label": "Reference DocType"
    },
    {
      "fieldname": "reference_name",
      "fieldtype": "Dynamic Link",
      "options": "reference_doctype",
      "label": "Reference Name"
    },
    {
      "fieldname": "icon",
      "fieldtype": "Data",
      "label": "Icon"
    },
    {
      "fieldname": "link_url",
      "fieldtype": "Data",
      "label": "Link URL"
    },
    {
      "fieldname": "message",
      "fieldtype": "Link",
      "options": "NP Message",
      "label": "Source Message"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "NP Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}