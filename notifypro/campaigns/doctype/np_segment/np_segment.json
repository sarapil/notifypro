{
  "name": "NP Segment",
  "module": "Campaigns",
  "doctype": "DocType",
  "engine": "InnoDB",
  "is_submittable": 0,
  "issingle": 0,
  "istable": 0,
  "editable_grid": 1,
  "track_changes": 1,
  "sort_field": "creation",
  "sort_order": "DESC",
  "naming_rule": "By fieldname",
  "autoname": "field:segment_name",
  "fields": [
    {
      "fieldname": "segment_name",
      "fieldtype": "Data",
      "label": "Segment Name",
      "reqd": 1
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Description"
    },
    {
      "fieldname": "source_doctype",
      "fieldtype": "Link",
      "options": "DocType",
      "label": "Source DocType"
    },
    {
      "fieldname": "filters_json",
      "fieldtype": "Code",
      "options": "JSON",
      "label": "Filters (JSON)"
    },
    {
      "fieldname": "recipient_field",
      "fieldtype": "Data",
      "label": "Recipient Field",
      "description": "Field on source DocType containing email/phone"
    },
    {
      "fieldname": "estimated_count",
      "fieldtype": "Int",
      "label": "Estimated Count",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "NP Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}