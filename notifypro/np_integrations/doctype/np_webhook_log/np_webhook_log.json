{
  "name": "NP Webhook Log",
  "module": "NP Integrations",
  "doctype": "DocType",
  "engine": "InnoDB",
  "is_submittable": 0,
  "issingle": 0,
  "istable": 0,
  "editable_grid": 1,
  "track_changes": 1,
  "sort_field": "creation",
  "sort_order": "DESC",
  "naming_rule": "Expression",
  "autoname": "NP-WHK-.#####",
  "fields": [
    {
      "fieldname": "source",
      "fieldtype": "Data",
      "label": "Source",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "event_type",
      "fieldtype": "Data",
      "label": "Event Type",
      "in_list_view": 1
    },
    {
      "fieldname": "payload",
      "fieldtype": "Code",
      "options": "JSON",
      "label": "Payload"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "options": "Received\nProcessed\nFailed",
      "label": "Status",
      "default": "Received",
      "in_list_view": 1
    },
    {
      "fieldname": "error",
      "fieldtype": "Small Text",
      "label": "Error"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "NP Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}