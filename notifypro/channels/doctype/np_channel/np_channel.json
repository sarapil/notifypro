{
  "name": "NP Channel",
  "module": "Channels",
  "doctype": "DocType",
  "engine": "InnoDB",
  "is_submittable": 0,
  "issingle": 0,
  "istable": 0,
  "editable_grid": 1,
  "track_changes": 1,
  "sort_field": "creation",
  "sort_order": "DESC",
  "naming_rule": "By fieldname",
  "autoname": "field:channel_name",
  "fields": [
    {
      "fieldname": "channel_name",
      "fieldtype": "Data",
      "label": "Channel Name",
      "reqd": 1
    },
    {
      "fieldname": "channel_type",
      "fieldtype": "Select",
      "options": "Email\nSMS\nWhatsApp\nTelegram\nPush\nIn-App\nSlack\nWebhook",
      "label": "Channel Type",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": "1"
    },
    {
      "fieldname": "priority",
      "fieldtype": "Int",
      "label": "Priority",
      "default": "10"
    },
    {
      "fieldname": "sb_provider",
      "fieldtype": "Section Break",
      "label": "Provider"
    },
    {
      "fieldname": "provider",
      "fieldtype": "Link",
      "options": "NP Channel Provider",
      "label": "Provider"
    },
    {
      "fieldname": "sb_limits",
      "fieldtype": "Section Break",
      "label": "Rate Limits"
    },
    {
      "fieldname": "rate_limit_per_minute",
      "fieldtype": "Int",
      "label": "Rate Limit/min"
    },
    {
      "fieldname": "rate_limit_per_hour",
      "fieldtype": "Int",
      "label": "Rate Limit/hr"
    },
    {
      "fieldname": "daily_limit",
      "fieldtype": "Int",
      "label": "Daily Limit"
    },
    {
      "fieldname": "sb_health",
      "fieldtype": "Section Break",
      "label": "Health"
    },
    {
      "fieldname": "last_health_check",
      "fieldtype": "Datetime",
      "label": "Last Health Check",
      "read_only": 1
    },
    {
      "fieldname": "health_status",
      "fieldtype": "Select",
      "options": "Unknown\nHealthy\nDegraded\nDown",
      "label": "Health Status",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "NP Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}